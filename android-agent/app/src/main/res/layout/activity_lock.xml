<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lock_gradient_bg">

    <!-- Top decorative circle -->
    <View
        android:id="@+id/topDecoration"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:background="@drawable/lock_gradient_bg"
        android:alpha="0.1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="-100dp"
        android:layout_marginEnd="-100dp"/>

    <!-- School Logo or Icon -->
    <ImageView
        android:id="@+id/ivSchoolLogo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@android:drawable/ic_secure"
        app:tint="#9C27B0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="80dp"
        android:background="@drawable/lock_gradient_bg"
        android:padding="24dp"/>

    <!-- Main Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thiết bị đã bị khóa"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/ivSchoolLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Subtitle / Message -->
    <TextView
        android:id="@+id/tvLockMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Thiết bị này đang trong thời gian quản lý của nhà trường. Vui lòng tập trung vào bài học."
        android:textSize="16sp"
        android:textColor="#BDBDBD"
        android:textAlignment="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Info Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="30dp"
        app:cardBackgroundColor="#1AFFFFFF"
        app:cardCornerRadius="16dp"
        app:strokeWidth="1dp"
        app:strokeColor="#33FFFFFF"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvLockMessage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_dialog_info"
                    app:tint="#9C27B0"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trạng thái"
                    android:textColor="#BDBDBD"
                    android:layout_marginStart="12dp"/>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đang Quản Lý"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Offline Unlock Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/cvInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <EditText
            android:id="@+id/etUnlockCode"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:hint="Nhập mã mở khóa..."
            android:textColorHint="#888888"
            android:textColor="#FFFFFF"
            android:inputType="textPassword"
            android:backgroundTint="#9C27B0"
            android:layout_marginEnd="10dp"/>
            
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnlock"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="MỞ KHÓA"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#9C27B0"
            app:cornerRadius="8dp"/>
    </LinearLayout>

    <!-- Bottom emergency info -->
    <TextView
        android:id="@+id/tvEmergency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chỉ có Giáo viên hoặc Quản trị viên mới có thể mở khóa thiết bị này."
        android:textSize="12sp"
        android:textColor="#757575"
        android:layout_marginBottom="32dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:textAlignment="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
