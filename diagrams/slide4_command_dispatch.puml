@startuml slide4_command_dispatch
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13

title <size:18><b>LUỒNG ĐIỀU KHIỂN THIẾT BỊ TỪ XA</b></size>

|👨‍💼 Admin|
start
:Nhấn gửi lệnh
(VD: Khóa máy, Hú còi...);

|🖥️ Server|
:Tạo lệnh trong Database
trạng thái = **PENDING**;

if (Thiết bị đang Online?) then (✅ Online)
  :Gửi ngay qua **WebSocket**;
  :Cập nhật trạng thái = **SENT**;
  
  |📱 Agent|
  :Nhận lệnh qua WebSocket;
  :Thực thi lệnh;
  :Gửi phản hồi (ACK);
  
  |🖥️ Server|
  :Cập nhật = **EXECUTED**;
  
else (❌ Offline)
  |🖥️ Server|
  :Xếp vào **hàng đợi Redis**
  (device:{id}:commands:pending);
  
  note right
    Khi thiết bị online lại
    và gửi Heartbeat,
    nó sẽ thấy
    pendingCommands > 0
    → tự gọi API lấy lệnh
  end note
  
  |📱 Agent|
  :...(chờ online lại)...;
  :Gửi Heartbeat → thấy có lệnh chờ;
  :Gọi GET /commands/pending;
  :Nhận & thực thi lệnh;
endif

stop

legend bottom right
  **Retry tự động:**
  Lệnh SENT > 5 phút chưa ACK
  → Reset về PENDING
  → Đẩy lại hàng đợi
endlegend

@enduml
